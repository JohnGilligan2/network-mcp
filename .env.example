# ===========================================================================
# network-mcp — copy to .env and fill in. .env is gitignored; keep it that way,
# it holds the login to every router we manage.
# ===========================================================================

# --- WHERE THIS SERVER MAY LOG IN ------------------------------------------
# The single most important setting here. This server holds shared device
# credentials and Telnet sends them in cleartext, so it refuses to connect to
# anything outside these ranges. A model reading a ticket, an email or a device
# banner cannot talk it into "just check 203.0.113.9" — the check is in code.
#
# Defaults to RFC1918 if unset. NARROW IT to your actual management ranges;
# "all of 10/8" is a lot of things this server could log in to.
NETMCP_ALLOWED_CIDRS=10.20.0.0/16,10.30.0.0/16,192.168.10.0/24
#
# To turn the gate OFF entirely, set 0.0.0.0/0,::/0 — which is what the
# Example Corp deployment runs today. Do it knowingly: the server will then try
# the shared device login against any address it is handed. Loopback,
# link-local, multicast and reserved stay refused regardless. The open state is
# reported by net_capabilities and warned about at startup rather than being
# silent.

# Carve-outs inside the above, checked first. Worth listing our own server
# subnets so the tool cannot be pointed at infrastructure rather than customer
# network gear.
#NETMCP_DENY_CIDRS=10.0.0.10/24

# --- SSH RELAY (jump host) -------------------------------------------------
# Set when this server has no direct route to the management networks, which is
# the normal case: the docker host is on the Example Corp LAN and the devices are
# not. Every device session becomes one SSH connection to the relay plus a
# direct-tcpip channel out to the device, for both SSH and Telnet.
#
# The relay address is NOT checked against NETMCP_ALLOWED_CIDRS. It is a
# configured value rather than a caller-supplied one, which is exactly why it
# can be a public address while device targets cannot.
#
# Requires AllowTcpForwarding (the sshd default) on the relay.
#NETMCP_JUMP_HOST=203.0.113.24
#NETMCP_JUMP_PORT=22
#NETMCP_JUMP_USERNAME=relayuser
# Base64 for the same reason as the device password — see above.
#NETMCP_JUMP_PASSWORD_B64=
# Preferred over a password: mount a key and point at it.
#NETMCP_JUMP_KEY_FILE=/keys/relay_ed25519
#NETMCP_JUMP_KEY_PASSPHRASE_B64=
# Pin the relay host key. Without it the first connect is trust-on-first-use,
# and a MITM on a public address gets the device credentials.
# net_relay_status prints the fingerprint.
#NETMCP_JUMP_HOST_KEY_SHA256=
#NETMCP_JUMP_TIMEOUT=20

# --- DEVICE CREDENTIALS ----------------------------------------------------
# Tried in the order listed until one authenticates. That is what makes "we
# have a standard login, except on the boxes we inherited" work without the
# caller knowing which is which.
NETMCP_CRED_PROFILES=default,legacy

NETMCP_CRED_DEFAULT_USERNAME=netadmin
# Prefer the _B64 form. Portainer substitutes stack variables into
# docker-compose.yml and Compose then expands the RESULT, so a `$` in a
# password is silently deleted and the login fails with no error anywhere.
# Generate with:  python -c "import base64;print(base64.b64encode(b'MyP@ss').decode())"
NETMCP_CRED_DEFAULT_PASSWORD_B64=
#NETMCP_CRED_DEFAULT_PASSWORD=plaintext-alternative-for-local-dev
NETMCP_CRED_DEFAULT_ENABLE_SECRET_B64=

NETMCP_CRED_LEGACY_USERNAME=admin
NETMCP_CRED_LEGACY_PASSWORD_B64=
NETMCP_CRED_LEGACY_ENABLE_SECRET_B64=

# Single-credential shortcut (used only when NETMCP_CRED_PROFILES is unset):
#NETMCP_USERNAME=netadmin
#NETMCP_PASSWORD=...
#NETMCP_ENABLE_SECRET=...

# --- TRANSPORT -------------------------------------------------------------
NETMCP_ALLOW_SSH=true
# Telnet exists for the older ADTRANs. Every Telnet result carries a warning
# saying the login crossed the network in cleartext. Set false once every
# device does SSH.
NETMCP_ALLOW_TELNET=true
# telnet_first = Telnet, then SSH as fallback. The default, and the right one
#   for our estate: ADTRANs ship Telnet-enabled and the older Ciscos have no SSH
#   at all, so leading with SSH spends a connect timeout per device learning
#   what we already know.
# auto = SSH first, Telnet as fallback.  ssh / telnet = that one only.
NETMCP_DEFAULT_TRANSPORT=telnet_first
NETMCP_SSH_PORT=22
NETMCP_TELNET_PORT=23
NETMCP_CONN_TIMEOUT=15
NETMCP_READ_TIMEOUT=60
# Raise to 2 or 4 if a slow WAN link or an old ADTRAN returns truncated output.
NETMCP_GLOBAL_DELAY_FACTOR=1.0

# --- OUTPUT ----------------------------------------------------------------
# Leave true. Configs are credential stores and an MCP result lands in a chat
# transcript permanently. There is no tool parameter that overrides this, on
# purpose — only this variable, changed deliberately by a person.
NETMCP_REDACT_SECRETS=true
NETMCP_MAX_OUTPUT_CHARS=200000
NETMCP_MAX_CONCURRENT_DEVICES=8

# --- OPTIONAL ON-DISK ARCHIVE ----------------------------------------------
# Unset = nothing is written to disk. Set = net_backup_configs also archives
# each config and reports whether it changed since last time.
# Files here are UNREDACTED (a redacted config cannot be restored, so it is not
# a backup). Treat the volume as a credential store.
#NETMCP_BACKUP_DIR=/archive
#NETMCP_BACKUP_REDACTED=false

# --- TRANSPORT (MCP) -------------------------------------------------------
# stdio = local Claude Code (default). http = deployed container.
#MCP_TRANSPORT=stdio
#MCP_BIND_HOST=0.0.0.0
#MCP_PORT=8000
#MCP_PATH=/mcp

# --- ENTRA ID (ONLY for the deployed HTTP server; leave off locally) -------
# Values come from scripts/setup_entra_app.ps1. The CLIENT SECRET is NOT here —
# it goes in Claude's connector Advanced settings (resource-server mode).
#MCP_AUTH_ENABLED=true
#MCP_BASE_URL=https://network-mcp.example.com
# Example Corp tenant
#ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
#ENTRA_CLIENT_ID=
#ENTRA_IDENTIFIER_URI=https://network-mcp.example.com/mcp
#ENTRA_SCOPE_NAME=access_as_user
#ENTRA_REQUIRED_SCOPES=access_as_user
